{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddk.dev/schemas/pack-manifest-v2.json",
  "title": "SDDK Pack Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "requires",
    "integrates_with",
    "provides",
    "conflicts_with",
    "content_hashes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "integrates_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provides": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "behaviors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "settings_schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}