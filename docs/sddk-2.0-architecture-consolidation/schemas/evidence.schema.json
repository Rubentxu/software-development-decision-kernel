{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddk.dev/schemas/evidence-v1.json",
  "title": "SDDK Evidence Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "kind",
    "captured_at",
    "actor",
    "subjects",
    "content_hash",
    "acquisition"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "version": {}
        }
      }
    },
    "artifact_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "acquisition": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validity": {
      "type": "object",
      "properties": {
        "bound_hashes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "enum": [
            "fresh",
            "possibly_stale",
            "stale",
            "invalidated",
            "unknown"
          ]
        }
      }
    },
    "redaction": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "policy_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}