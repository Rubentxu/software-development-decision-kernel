{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddk.dev/schemas/behavioral-ir-v1.json",
  "title": "SDDK Behavioral IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "pack",
    "triggers",
    "read_scope",
    "outputs",
    "capabilities",
    "execution",
    "identity"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "deterministic_behavior",
        "agent_behavior",
        "relation_behavior"
      ]
    },
    "pack": {
      "type": "string"
    },
    "triggers": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_scope": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "deterministic",
            "agentic"
          ]
        },
        "model_constraints": {
          "type": "object"
        },
        "budget": {
          "type": "object"
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "definition_hash"
      ],
      "properties": {
        "definition_hash": {
          "type": "string"
        },
        "prompt_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "skill_set_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}