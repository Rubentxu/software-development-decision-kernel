{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddk.dev/schemas/stage-report.v1.json",
  "title": "StageReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "phase",
    "objective",
    "next",
    "human_action_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "cycle_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reframes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "string"
    },
    "human_action_required": {
      "type": "boolean"
    },
    "attention": {
      "type": "string"
    }
  }
}
