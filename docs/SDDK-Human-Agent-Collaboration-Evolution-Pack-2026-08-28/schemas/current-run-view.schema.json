{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddk.dev/schemas/current-run-view.v1.json",
  "title": "CurrentRunView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_status",
    "human_action_required",
    "authority_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cycle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "progress": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_action_required": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
