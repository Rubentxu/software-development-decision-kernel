{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./debt-report.schema.json",
  "title": "SDDK debt report (per-cycle)",
  "description": "Per-cycle debt findings emitted by sddk-debt-verify and consumed by sddk-archive. See ADR-0047 §3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cycle_id", "generated_at", "findings"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0", "1.1.0"] },
    "cycle_id": { "type": "string", "pattern": "^p-[a-f0-9]{16}/kernel-cycle-[0-9]+[a-z]?-[a-z0-9-]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "priority", "status", "fingerprint", "fingerprint_aliases", "cluster_id", "category", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^FIND-[0-9]{4,6}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "type": "string", "enum": ["open", "in-progress", "deferred", "resolved", "superseded"] },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "fingerprint_aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" } },
        "cluster_id": { "type": "string", "pattern": "^CL-[0-9]{2,4}$" },
        "category": { "type": "string", "enum": ["smells", "coupling", "duplication", "over-engineering", "architecture", "reliability", "resilience", "risk", "readability"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "remediation_pr": { "type": "string", "nullable": true },
        "remediation_cycle": { "type": "string", "nullable": true },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string" },
              "ref": { "type": "string" }
            },
            "required": ["kind", "ref"]
          }
        }
      }
    }
  }
}
