#!/bin/bash
# pre-push hook — Mechanical push prevention for CL-APPLY-PUSH-DISCIPLINE
# INC: INC-MATRIX-LINT-CODES-APPLY-PUSH-VIOLATION
#
# Rejects push to refs/heads/main unless the commit range contains EITHER:
#   (1) a release commit with subject matching ^chore\(release\): bump version, OR
#   (2) a semantic version bump in Cargo.toml ([workspace.package] or any [package])
#       detectable via `git diff` of `Cargo.toml` across the commit range.
#
# This dual-condition prevents the "ceremonial marker commit" smell documented in
# INC-M7-9-PRE-PUSH-HOOK-CEREMONIAL-COMMIT (option 3 implementation):
#   - Real release commits bump Cargo.toml → pass via semantic check (no marker needed)
#   - Post-release doc handoffs with empty `chore(release): bump version to v1.167.8
#     (already published)` markers pass via the regex check (preserves existing flow)
#   - Plain doc commits without any version bump AND without a marker still fail
#     (preserves the original safety guarantee)
#
# stdin contract: <local_ref> <local_sha> <remote_ref> <remote_sha>
# zero remote_sha means new branch (range is HEAD..local_sha)
# zero local_sha means branch deletion

DISCIPLINE="apply/release split"
INC_IDENTIFIER="INC-MATRIX-LINT-CODES-APPLY-PUSH-VIOLATION"
INC_CEREMONIAL="INC-M7-9-PRE-PUSH-HOOK-CEREMONIAL-COMMIT"
RELEASE_COMMIT_REGEX="^chore\(release\): bump version"
CARGO_TOML_PATH="Cargo.toml"

# Helper: extract the [workspace.package] version from Cargo.toml content.
# Returns empty string if no workspace.package.version key is found.
cargo_workspace_version() {
    local cargo_content="$1"
    # Use awk to extract the workspace.package.version block
    echo "$cargo_content" | awk '
        /^\[workspace\.package\]/ { in_block=1; next }
        /^\[/ { in_block=0 }
        in_block && /^version[[:space:]]*=/ {
            match($0, /"[^"]*"/)
            print substr($0, RSTART+1, RLENGTH-2)
            exit
        }
    '
}

# Read all lines from stdin
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    # Skip empty lines
    [[ -z "$local_ref" ]] && continue

    # Only check pushes to refs/heads/main
    if [[ "$local_ref" != "refs/heads/main" ]]; then
        # Non-main refs always pass
        continue
    fi

    # Check for deletion of main: local_sha is all zeros (40 zeros)
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        echo "ERROR: Deletion of main is not allowed. ($DISCIPLINE | $INC_IDENTIFIER)" >&2
        exit 1
    fi

    # Determine the commits to check
    # If remote_sha is zeros, it's a new branch — check all commits on the branch
    # Otherwise, check commits from the remote's current state to the new state
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        # New branch: check if HEAD contains a release commit
        COMMITS_TO_CHECK=$(git rev-list --reverse HEAD 2>/dev/null)
    else
        # Existing branch: check if the new commits contain a release commit
        # Use git merge-base to find the common ancestor
        if git rev-parse --verify --quiet "$remote_sha" >/dev/null 2>&1; then
            # remote_sha exists locally — check commits between it and local_sha
            COMMITS_TO_CHECK=$(git rev-list --reverse "$remote_sha..$local_sha" 2>/dev/null)
        else
            # remote_sha does not exist locally (e.g. file:// protocol)
            # Be conservative: check all commits on the branch
            COMMITS_TO_CHECK=$(git rev-list --reverse HEAD 2>/dev/null)
        fi
    fi

    # Check 1: any commit in the range matches the release commit regex (subject)
    RELEASE_COMMIT=""
    for commit in $COMMITS_TO_CHECK; do
        msg=$(git log -1 --format=%s "$commit" 2>/dev/null)
        if echo "$msg" | grep -qE "$RELEASE_COMMIT_REGEX"; then
            RELEASE_COMMIT="$msg"
            break
        fi
    done

    # Check 2: any commit in the range bumps [workspace.package] version in Cargo.toml
    SEM_VER_BUMP=""
    for commit in $COMMITS_TO_CHECK; do
        # Compare Cargo.toml content before and after this commit
        prev_sha=$(git rev-parse "$commit^" 2>/dev/null || true)
        if [[ -z "$prev_sha" ]]; then
            continue
        fi
        old_cargo=$(git show "$prev_sha:$CARGO_TOML_PATH" 2>/dev/null || true)
        new_cargo=$(git show "$commit:$CARGO_TOML_PATH" 2>/dev/null || true)
        if [[ -z "$old_cargo" || -z "$new_cargo" ]]; then
            continue
        fi
        old_ver=$(cargo_workspace_version "$old_cargo")
        new_ver=$(cargo_workspace_version "$new_cargo")
        if [[ -n "$old_ver" && -n "$new_ver" && "$old_ver" != "$new_ver" ]]; then
            SEM_VER_BUMP="$commit ($old_ver -> $new_ver)"
            break
        fi
    done

    if [[ -z "$RELEASE_COMMIT" && -z "$SEM_VER_BUMP" ]]; then
        echo "ERROR: Push to main rejected — no release marker or Cargo.toml version bump found in range." >&2
        echo "ERROR: ($DISCIPLINE | $INC_IDENTIFIER)" >&2
        echo "ERROR: A push to main requires EITHER:" >&2
        echo "ERROR:   (1) a commit with subject matching:  $RELEASE_COMMIT_REGEX" >&2
        echo "ERROR:   (2) a commit that bumps [workspace.package] version in $CARGO_TOML_PATH" >&2
        echo "ERROR: ($DISCIPLINE | $INC_CEREMONIAL) — see INC-M7-9 for remediation options" >&2
        exit 1
    fi

done

# All checks passed
exit 0
