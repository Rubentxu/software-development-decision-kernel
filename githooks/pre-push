#!/bin/bash
# pre-push hook — mechanical push admission for refs/heads/main
#
# Cluster: CL-APPLY-PUSH-DISCIPLINE
# INCs:    INC-MATRIX-LINT-CODES-APPLY-PUSH-VIOLATION
#          INC-M7-9-PRE-PUSH-HOOK-CEREMONIAL-COMMIT (closed by A5-1)
#          INC-A5-PUSH-RELEASE-MARKER-FRICTION      (closed by A5-1)
#          INC-AIWS1-RECEIPT-PUSH-BLOCK             (cycle-artifacts docs)
#
# A5-1 contract (amended by cycle inc-receipt-push-admission) — a push to
# refs/heads/main is ACCEPTED iff:
#
#   (A) the pushed range contains a REAL `[workspace.package] version`
#       change in Cargo.toml (old != new), OR the workspace version at the
#       pushed tip is semver-greater than the maximum published v* tag on
#       the remote (INC-DEBT-040 variant 3: a bump already merged into
#       origin/main is outside the pushed range by construction, so the
#       range-local check alone is unsatisfiable for a declared-but-
#       unreleased version). The tag query is FAIL-CLOSED: if the remote
#       cannot answer, this route does not admit the push and the range
#       must contain the bump or docs-only paths. OR
#   (B) the pushed range is NON-EMPTY and EVERY changed path lies inside
#       the closed documentation-only allowlist:
#         docs/**
#         .sddk/followups/**
#         tests/cycle-artifacts/p-*/<cycle>/{SCOPE-CONTRACT,DISCOVERY,RECEIPT}.md
#         AND no changed file contains a secret pattern (added by the
#         same amendment: allowing a route is not certifying content).
#
#   (C) INC-PUSH-DERIVED-METADATA-NO-ADMISSIBLE-PATH (closed): a NON-EMPTY
#       range whose changed paths are ALL generated-derived metadata
#       (MANIFEST.sha256) plus documentation-only paths from (B). This
#       admits a pure manifest-regeneration commit without burning a
#       version number. Any source path alongside the manifest still
#       requires (A) — generated metadata can never smuggle source.
#
# Only the three named documentary files are admitted under
# tests/cycle-artifacts/ — raw logs, fixtures and dumps stay outside
# the publishable surface.
#
# The commit SUBJECT is NOT authority. This kills the ceremonial
# `chore(release): bump version (cycle close marker)` empty commit: an empty
# range has zero changed paths, so (B) fails (count > 0 is required) and (A)
# finds no version change.
#
# stdin contract: <local_ref> <local_sha> <remote_ref> <remote_sha>
# zero remote_sha  -> new branch (range = whole history)
# zero local_sha   -> branch deletion

DISCIPLINE="apply/release split"
INC_IDENTIFIER="INC-MATRIX-LINT-CODES-APPLY-PUSH-VIOLATION"
INC_CEREMONIAL="INC-A5-PUSH-RELEASE-MARKER-FRICTION"
CARGO_TOML_PATH="Cargo.toml"
# Scratch file for the tag query result; recreated per push invocation.
TMP_TAG_OUT="$(mktemp "${TMPDIR:-/tmp}/sddk-prepush-tags.XXXXXX")"

# INC-DEBT-040 variant 3: maximum published v* version on the remote,
# stripped of the `v` prefix. Empty output means bootstrap (no v* tags).
# Fails by returning non-zero when the remote cannot answer — the caller
# treats that as "route unavailable", never as "no published version".
max_published_version() {
    local raw rc tag
    raw="$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags origin 2>&1)"
    rc=$?
    if [[ $rc -ne 0 ]]; then
        return 1
    fi
    tag="$(printf '%s\n' "$raw" \
        | awk '{print $2}' \
        | sed -n 's|^refs/tags/v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$|\1|p' \
        | sort -V -r \
        | head -1)"
    printf '%s' "$tag"
    return 0
}

# semver_gt <a> <b>: 0 iff a > b under dotted numeric comparison
# (same semantics as scripts/lib/release_admission.sh).
semver_gt_hook() {
    local a="$1" b="$2"
    [[ "$a" == "$b" ]] && return 1
    local IFS=. av bv i ai bi
    # shellcheck disable=SC2206
    av=($a)
    # shellcheck disable=SC2206
    bv=($b)
    for i in 0 1 2; do
        ai="${av[$i]:-0}"
        bi="${bv[$i]:-0}"
        [[ "$ai" =~ ^[0-9]+$ ]] || ai=0
        [[ "$bi" =~ ^[0-9]+$ ]] || bi=0
        if ((10#$ai > 10#$bi)); then return 0; fi
        if ((10#$ai < 10#$bi)); then return 1; fi
    done
    return 1
}

# Extract the [workspace.package] version from Cargo.toml content (empty if absent).
cargo_workspace_version() {
    local cargo_content="$1"
    echo "$cargo_content" | awk '
        /^\[workspace\.package\]/ { in_block=1; next }
        /^\[/ { in_block=0 }
        in_block && /^version[[:space:]]*=/ {
            match($0, /"[^"]*"/)
            print substr($0, RSTART+1, RLENGTH-2)
            exit
        }
    '
}

# Closed documentation-only allowlist. Keep small and explicit.
is_allowed_path() {
    case "$1" in
        docs/* | .sddk/followups/*) return 0 ;;
        # Cycle documentary files only (INC-AIWS1-RECEIPT-PUSH-BLOCK).
        # Cycle id segment must be non-empty; project id is p- prefixed.
        tests/cycle-artifacts/p-*/*/SCOPE-CONTRACT.md | tests/cycle-artifacts/p-*/*/DISCOVERY.md | tests/cycle-artifacts/p-*/*/RECEIPT.md) return 0 ;;
        *) return 1 ;;
    esac
}

# Generated-derived metadata (INC-PUSH-DERIVED-METADATA-NO-ADMISSIBLE-PATH).
# Closed set: files whose content is fully derived from bundle assets by
# `sddk dev manifest`. Admissible only when NO source path changed in the
# same range (checked by the caller).
is_generated_path() {
    case "$1" in
        MANIFEST.sha256) return 0 ;;
        *) return 1 ;;
    esac
}

# Secret pattern screen for newly admitted cycle docs (heuristic, high
# confidence only: known token prefixes + credential assignments).
# Rationale: admitting a path is not certifying its content.
#
# INC-AIWS1-RECEIPT-PUSH-BLOCK canary purref (cycle inc-push-hook-canary-purref):
# the original regex matches test-canary placeholders like `api_key=CANARY_…`
# or `token=<REDACTED>`, blocking legitimate receipts whose falsification
# battery documents a redaction pass. We pre-filter lines that contain a
# redactable placeholder (<…>, {…}, <redacted:N>, ellipsis … or ...) and
# apply the regex only to the residue. Real high-confidence secrets
# (ghp_…, github_pat_…, AKIA…, xox[baprs]-…, PEM headers, key="literal>=8")
# do not contain such placeholders and remain rejected.
file_contains_secret_pattern() {
    # Reads the file contents from stdin. The caller pipes `git show` output.
    #
    # INC-AIWS1-RECEIPT-PUSH-BLOCK canary purref (cycle inc-push-hook-canary-purref):
    # pre-filter lines that contain a redactable placeholder token before
    # applying the secret regex. The placeholder forms are:
    #   - "<redacted:N>"             (the redaction length tag)
    #   - "<TOKEN_NAME>"             (uppercase placeholders, used in docs/tests)
    #   - "{TOKEN_NAME}"             (brace-quoted placeholders)
    #   - "…"  (U+2026, UTF-8 E2 80 A6)
    # Lines containing any of them are removed; the regex then runs over the
    # residue. Real high-confidence secrets (ghp_…, github_pat_…, AKIA…,
    # xox[baprs]-…, sk-…, PEM headers, key="literal>=8") do not appear with
    # placeholders and continue to be detected.
    awk '
        BEGIN { IGNORECASE = 1 }
        {
            if (index($0, "<redacted:") > 0)                       next
            line = tolower($0)
            if (match(line, /<[a-z_][a-z0-9_-]*>/))                next
            if (match($0,    /\{[A-Za-z_][A-Za-z0-9_-]*\}/))       next
            if (index($0, "\xe2\x80\xa6") > 0)                     next
            print
        }
    ' | grep -qE '(ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{20,}|-----BEGIN (RSA|EC|OPENSSH|PGP|DSA) PRIVATE KEY-----|"(api[_-]?key|secret[_-]?key|access[_-]?token|password)"?[[:space:]]*[:=][[:space:]]*"[^" ]{8,}|(api[_-]?key|secret[_-]?key|access[_-]?token|password)[[:space:]]*[:=][[:space:]]*[^ ][^ ]{8,})'
}

# remote_ref is part of the stdin contract but is not needed here.
# shellcheck disable=SC2034
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "$local_ref" ]] && continue

    # Only gate pushes to refs/heads/main.
    if [[ "$local_ref" != "refs/heads/main" ]]; then
        continue
    fi

    # Deletion of main is never allowed.
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        echo "ERROR: Deletion of main is not allowed. ($DISCIPLINE | $INC_IDENTIFIER)" >&2
        exit 1
    fi

    # Resolve the commit range to check.
    NEW_BRANCH=0
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        NEW_BRANCH=1
        COMMITS_TO_CHECK=$(git rev-list --reverse "$local_sha" 2>/dev/null)
    elif git rev-parse --verify --quiet "$remote_sha" >/dev/null 2>&1; then
        COMMITS_TO_CHECK=$(git rev-list --reverse "$remote_sha..$local_sha" 2>/dev/null)
    else
        # remote_sha unknown locally (e.g. file:// protocol) — be conservative.
        COMMITS_TO_CHECK=$(git rev-list --reverse "$local_sha" 2>/dev/null)
    fi

    # §3 — an empty range is never admissible.
    if [[ -z "$COMMITS_TO_CHECK" ]]; then
        echo "ERROR: Push to main rejected — empty commit range (nothing to admit)." >&2
        echo "ERROR: ($DISCIPLINE | $INC_IDENTIFIER)" >&2
        exit 1
    fi

    # Changed paths for the pushed range (shared by routes A-v2 and B).
    if [[ "$NEW_BRANCH" -eq 1 ]]; then
        CHANGED_PATHS=$(git ls-tree -r --name-only "$local_sha" 2>/dev/null)
    else
        # --no-renames so a rename contributes BOTH the old and the new path;
        # a rename that touches any non-allowed path is therefore rejected.
        CHANGED_PATHS=$(git diff --name-only --no-renames "$remote_sha" "$local_sha" 2>/dev/null)
    fi
    CHANGED_COUNT=0
    while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        CHANGED_COUNT=$((CHANGED_COUNT + 1))
    done <<<"$CHANGED_PATHS"

    # (A) real [workspace.package] version change in the range.
    VERSION_BUMP=""
    for commit in $COMMITS_TO_CHECK; do
        prev_sha=$(git rev-parse --verify --quiet "$commit^" 2>/dev/null || true)
        [[ -z "$prev_sha" ]] && continue
        old_cargo=$(git show "$prev_sha:$CARGO_TOML_PATH" 2>/dev/null || true)
        new_cargo=$(git show "$commit:$CARGO_TOML_PATH" 2>/dev/null || true)
        [[ -z "$old_cargo" || -z "$new_cargo" ]] && continue
        old_ver=$(cargo_workspace_version "$old_cargo")
        new_ver=$(cargo_workspace_version "$new_cargo")
        if [[ -n "$old_ver" && -n "$new_ver" && "$old_ver" != "$new_ver" ]]; then
            VERSION_BUMP="$commit ($old_ver -> $new_ver)"
            break
        fi
    done

    if [[ -n "$VERSION_BUMP" ]]; then
        continue
    fi

    # (A-v2, INC-DEBT-040 variant 3) Tag-baseline admission, aligned with
    # release_admission_check_v2: the workspace version at the pushed tip
    # exceeds every published v* tag on the remote. The bump that declared
    # this release may already be merged into origin/main, so a range-local
    # search can never see it; during that declared-but-unpublished window
    # the release contract exists at the tip, and any non-empty range is
    # admissible. Bootstrap (remote answered, no v* tags) admits the first
    # declared version. FAIL-CLOSED: if the tag query cannot answer, this
    # route stays closed and the range must satisfy (A) or (B).
    if [[ "$CHANGED_COUNT" -gt 0 ]]; then
        tip_version="$(cargo_workspace_version "$(git show "$local_sha:$CARGO_TOML_PATH" 2>/dev/null || true)")"
        if [[ -n "$tip_version" ]] && max_published_version >"$TMP_TAG_OUT" 2>/dev/null; then
            last_pub="$(cat "$TMP_TAG_OUT")"
            if [[ -z "$last_pub" ]] || semver_gt_hook "$tip_version" "$last_pub"; then
                continue
            fi
        fi
    fi

    # (B) non-empty range entirely inside the docs-only allowlist
    # (CHANGED_PATHS/CHANGED_COUNT computed above).
    DOCS_ONLY=1
    while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        if ! is_allowed_path "$path" && ! is_generated_path "$path"; then
            DOCS_ONLY=0
            break
        fi
    done <<<"$CHANGED_PATHS"

    # §3 — require count > 0 so the empty set cannot pass vacuously.
    if [[ "$CHANGED_COUNT" -gt 0 && "$DOCS_ONLY" -eq 1 ]]; then
        # Secret screen: only newly admitted cycle docs need content
        # screening; docs/** and followups retain their historical
        # treatment.
        CYCLE_DOCS=()
        while IFS= read -r p; do
            [[ "$p" == tests/cycle-artifacts/* ]] && CYCLE_DOCS+=("$p")
        done <<<"$CHANGED_PATHS"
        if [[ ${#CYCLE_DOCS[@]} -gt 0 ]]; then
            for f in "${CYCLE_DOCS[@]}"; do
                if git cat-file -e "$local_sha:$f" 2>/dev/null && \
                   git show "$local_sha:$f" | file_contains_secret_pattern -; then
                    echo "ERROR: Push to main rejected — cycle documentary file looks like it contains a secret: $f" >&2
                    echo "ERROR: ($DISCIPLINE | INC-AIWS1-RECEIPT-PUSH-BLOCK)" >&2
                    echo "ERROR: Redact the secret and re-commit; allowing the route does not certify content." >&2
                    exit 1
                fi
            done
        fi
        continue
    fi

    echo "ERROR: Push to main rejected — no real release contract found in range." >&2
    echo "ERROR: ($DISCIPLINE | $INC_IDENTIFIER)" >&2
    echo "ERROR: A push to main requires EITHER:" >&2
    echo "ERROR:   (1) a commit that changes [workspace.package] version in $CARGO_TOML_PATH" >&2
    echo "ERROR:   (2) a NON-EMPTY range whose changed paths are all under: docs/**, .sddk/followups/**, tests/cycle-artifacts/p-*/*/SCOPE-CONTRACT.md|DISCOVERY.md|RECEIPT.md, MANIFEST.sha256 (generated-only)" >&2
    echo "ERROR: A commit subject (e.g. 'chore(release): bump version') is NOT authority." >&2
    echo "ERROR: ($INC_CEREMONIAL) — see INC-M7-9 for remediation options" >&2
    exit 1

done

rm -f "$TMP_TAG_OUT" 2>/dev/null || true
exit 0
