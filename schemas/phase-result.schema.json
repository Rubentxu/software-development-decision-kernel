{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddk.dev/schemas/phase-result.schema.json",
  "title": "SDDK Phase Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "phase",
    "success",
    "summary",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": ["explore", "specify", "design", "plan", "build", "verify", "review", "release", "archive"]
    },
    "success": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "artifact-ref.schema.json"
      }
    },
    "errors": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
