{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim",
  "type": "object",
  "required": ["claim_id", "chapter", "text", "card_id", "source_id", "status"],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^claim-ch[0-9]+[a-z]?-[0-9]{3}$"
    },
    "chapter": { "type": "string" },
    "text": { "type": "string" },
    "card_id": { "type": "string" },
    "source_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["verified", "unverified", "disputed", "needs_recheck"]
    },
    "verified_at": { "type": "string", "format": "date" },
    "severity": {
      "type": "string",
      "enum": ["critical", "normal", "minor"]
    }
  }
}
